set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

gradle := "./gradlew"

# Show the backend recipes available in this directory.
help:
    @just --list

# Print the backend Gradle and JVM versions.
version:
    {{ gradle }} --version

# Run the backend locally with the requested Spring profile. Default: `dev`.
run profile='dev':
    {{ gradle }} bootRun --args="--spring.profiles.active={{ profile }}"

# Build the backend jar and run the standard Gradle build lifecycle.
build:
    {{ gradle }} build --no-daemon --parallel --build-cache

# Build the backend jar and export build/openapi/grimmory-openapi.json.
openapi-export:
    {{ gradle }} buildOpenApiArtifacts --no-daemon --parallel --build-cache

# Run the backend test suite.
test:
    {{ gradle }} test --no-daemon --parallel --build-cache

# Run a single backend test class, for example `just test-class test_class=org.booklore.service.BookServiceTest`.
test-class test_class:
    {{ gradle }} test --tests "{{ test_class }}" --no-daemon --parallel --build-cache

# Run backend tests in the JDK 25 Gradle image from dev.docker-compose.yml, optionally narrowed by a Gradle test filter, for example `just test-docker 'org.booklore.service.BookServiceTest'`.
test-docker filter='':
    docker compose -f ../dev.docker-compose.yml run --rm --no-deps -T backend sh -c 'cd /backend && ./gradlew test --no-daemon --build-cache {{ if filter == "" { "" } else { "--tests \"" + filter + "\"" } }}'

# Run the Moon+ sync position conversion library tests in Docker. Books that can't be committed are mounted read-only when found: MOON_LOCAL_BOOKS (the device test books, any file names) and MOON_READSYNC_FIXTURES (readsync's tests/fixtures/grimmory, default: the readsync checkout next to this repo). Tests needing an absent book are reported as skipped.
test-moon-position:
    abs() { (cd "$1" && (pwd -W 2>/dev/null || pwd)); }; args=(); \
    fixtures="${MOON_READSYNC_FIXTURES:-{{ source_directory() }}/../../readsync/tests/fixtures/grimmory}"; \
    if [[ -d "$fixtures" ]]; then args+=(-v "$(abs "$fixtures"):/moon-readsync-fixtures:ro" -e MOON_READSYNC_FIXTURES=/moon-readsync-fixtures); fi; \
    if [[ -n "${MOON_LOCAL_BOOKS:-}" ]]; then args+=(-v "$(abs "$MOON_LOCAL_BOOKS"):/moon-local-books:ro" -e MOON_LOCAL_BOOKS=/moon-local-books); fi; \
    MSYS_NO_PATHCONV=1 docker compose -f ../dev.docker-compose.yml run --rm --no-deps -T ${args[@]+"${args[@]}"} backend \
      sh -c 'cd /backend && ./gradlew test --no-daemon --build-cache --tests "org.booklore.service.moonsync.position.*"'

# Run tests and generate JaCoCo coverage output.
coverage:
    {{ gradle }} test jacocoTestReport --no-daemon --parallel --build-cache

# Run the Gradle `check` lifecycle used for local backend verification.
check:
    {{ gradle }} check --no-daemon --parallel --build-cache

# Remove backend build outputs.
clean:
    {{ gradle }} clean --no-daemon

# List the available backend Gradle tasks.
tasks:
    {{ gradle }} tasks --all --no-daemon
